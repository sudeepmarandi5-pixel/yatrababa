{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Fashion item showcased on Yatrababa.com with affiliate shopping links",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "slug": { "type": "string", "maxLength": 200 },
        "imageUrl": { "type": "string", "maxLength": 2048 },
        "shortDescription": { "type": "string", "maxLength": 500 },
        "fullDescription": { "type": "string", "maxLength": 5000 },
        "categoryId": { "type": "string", "maxLength": 100 },
        "categoryName": { "type": "string", "maxLength": 100 },
        "brand": { "type": "string", "maxLength": 100 },
        "price": { "type": "number" },
        "currency": { "type": "string", "maxLength": 10 },
        "affiliateUrl": { "type": "string", "maxLength": 2048 },
        "availabilityNote": { "type": "string", "maxLength": 200 },
        "isFeatured": { "type": "boolean" },
        "isEditorsPick": { "type": "boolean" },
        "isTrending": { "type": "boolean" },
        "status": { "type": "string", "enum": ["draft", "published"] },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["name", "slug", "imageUrl", "categoryId", "status"]
    },
    "Category": {
      "title": "Category",
      "description": "Fashion category (Western Wear, Saree Collection, Desi Style, etc.)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "slug": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 1000 },
        "imageUrl": { "type": "string", "maxLength": 2048 },
        "order": { "type": "number" },
        "isEnabled": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["name", "slug", "isEnabled"]
    },
    "Collection": {
      "title": "Collection",
      "description": "Curated editorial collections like Everyday Elegance, Party Wear Picks",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 150 },
        "description": { "type": "string", "maxLength": 500 },
        "order": { "type": "number" },
        "isEnabled": { "type": "boolean" }
      },
      "required": ["title", "isEnabled"]
    },
    "SiteSettings": {
      "title": "SiteSettings",
      "description": "Global website configuration, hero banner, social media links, and branding",
      "type": "object",
      "properties": {
        "websiteTitle": { "type": "string", "maxLength": 100 },
        "contactEmail": { "type": "string", "maxLength": 120 },
        "currency": { "type": "string", "maxLength": 10 },
        "locale": { "type": "string", "maxLength": 20 },
        "affiliateDisclosure": { "type": "string", "maxLength": 2000 },
        "footerText": { "type": "string", "maxLength": 500 },
        "aboutContent": { "type": "string", "maxLength": 5000 }
      },
      "required": ["websiteTitle", "contactEmail"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Fashion catalog items"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Navigation and catalog categories"
    },
    "/collections/{collectionId}": {
      "schema": "Collection",
      "description": "Curated homepage collections"
    },
    "/siteSettings/{settingsId}": {
      "schema": "SiteSettings",
      "description": "Site-wide configurations"
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "Admin" },
      "description": "Administrator accounts and RBAC"
    }
  }
}
